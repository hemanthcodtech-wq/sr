# ============================================================
# SR Multi-Vendor Marketplace - Root Git Ignore
# ============================================================

# Dependencies
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# Production / Build outputs
dist/
dist-ssr/
client/dist/
build/

# Environment files and secrets (NEVER commit secrets!)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

client/.env
client/.env.*
client/.env.local
!client/.env.example

server/.env
server/.env.*
server/.env.local
!server/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE directories
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files & Scratch
scratch/
server/scratch/
.tempmediaStorage/
