# Backend API Base URL
# - Local Development: /api (proxied via Vite to http://localhost:5000)
# - Production on Netlify: Set this in Netlify Site Settings -> Environment Variables
#   e.g. https://your-backend-api.onrender.com/api
VITE_API_URL=/api

# Razorpay Key ID
# Get from Razorpay Dashboard: Settings -> API Keys (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_TfwrOlkqXf2RIf
